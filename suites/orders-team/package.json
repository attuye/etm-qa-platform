{
  "name": "@etm/orders-team",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:api": "jest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:perf": "k6 run perf/orders-load.js",
    "test:mobile": "node -e \"require('fs').mkdirSync('reports', { recursive: true })\" && maestro test -e API_URL=http://localhost:3001/api --format junit --output reports/maestro-junit.xml mobile"
  },
  "devDependencies": {
    "@etm/qa-api-client": "^0.1.0",
    "@etm/qa-config": "^0.1.0",
    "@etm/qa-data": "^0.1.0",
    "@etm/qa-playwright": "^0.1.0",
    "@google-cloud/pubsub": "^6.3.2",
    "@jest/globals": "^30.5.2",
    "@playwright/test": "^1.64.1",
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "expect": "^30.5.2",
    "jest": "^30.5.2"
  }
}
